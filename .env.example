# Environment Configuration
APP_ENV=dev
APP_DEBUG=true

# Database Driver: pgsql (PostgreSQL), mysql (MySQL), or sqlite (SQLite)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=holybible
DB_USER=postgres
DB_PASSWORD=postgres

# SQLite fallback path (used when DB_DRIVER=sqlite or when PostgreSQL connection is absent in dev)
# DB_SQLITE_PATH=data/bible.sqlite
