{
    "name": "efrj/scriptorium",
    "type": "project",
    "description": "Scriptorium - Biblical study, multi-version reader, and comparison web application built with Yii 3",
    "keywords": [
        "yii3",
        "bible",
        "holy-bible",
        "postgresql",
        "mysql",
        "sqlite",
        "bootstrap5",
        "monolith"
    ],
    "license": "MIT",
    "scripts": {
        "serve": "php -S 0.0.0.0:8080 -t public"
    },
    "require": {
        "php": ">=8.2",
        "ext-filter": "*",
        "ext-pdo": "*",
        "httpsoft/http-message": "^1.1.6",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.0 || ^8.0",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/db": "^1.0",
        "yiisoft/db-migration": "^1.0",
        "yiisoft/db-mysql": "^1.0",
        "yiisoft/db-pgsql": "^1.0",
        "yiisoft/db-sqlite": "^1.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/html": "^4.0",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/session": "^3.0.1",
        "yiisoft/view": "^12.2.4",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    }
}
